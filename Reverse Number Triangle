public class Solution {
    public static void nNumberTriangle(int n) {
        int i=1;
        while(n>0){
        System.out.print(i+" ");
        if(n==1){
            break;
        }
        i++;
        if(i==n){
            System.out.println(i+" ");
            i=1;
            n--;
        }
        }
    }
}
