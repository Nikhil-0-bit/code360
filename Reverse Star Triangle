public class Solution {
    public static void nStarTriangle(int n) {
        // Write your code here
        int s=n+1;
        for(int i=0;i<n;i++){
            s--;
            for(int j=0;j<i;j++){
                System.out.print(" ");
            }
            for(int k=s*2-1;k>0;k--){
                System.out.print("*");
            }
            System.out.println();
        }
    }
}
